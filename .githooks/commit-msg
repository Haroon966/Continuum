#!/usr/bin/env bash
# Strip AI / Cursor credit trailers from commit messages before the commit lands.
# Author stays the human only — no Co-authored-by Cursor, Copilot, etc.
set -euo pipefail

MSG_FILE="${1:?commit-msg hook requires a message file}"
[[ -f "$MSG_FILE" ]] || exit 0

tmp="$(mktemp)"
# Keep human Co-authored-by; drop known AI / agent trailers and "made with" credits.
grep -Eiv \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor[[:space:]]*<' \
  -e '^[[:space:]]*Co-authored-by:.*<cursoragent@cursor\.com>' \
  -e '^[[:space:]]*Co-authored-by:.*@cursor\.com>' \
  -e '^[[:space:]]*Co-authored-by:.*(Cursor Agent|GitHub Copilot|Copilot|OpenAI|Anthropic|Claude|ChatGPT|Gemini|Devin)' \
  -e '^[[:space:]]*(Made-with|Generated-by|Generated by|Signed-off-by):.*(Cursor|Copilot|OpenAI|Anthropic|Claude)' \
  "$MSG_FILE" >"$tmp" || true

# Drop trailing blank lines left after stripping trailers
# (awk keeps internal blanks; only trims end)
awk 'NF{p=1} p' "$tmp" | awk '
  { lines[NR]=$0 }
  END {
    end=NR
    while (end>0 && lines[end] ~ /^[[:space:]]*$/) end--
    for (i=1; i<=end; i++) print lines[i]
  }
' >"$MSG_FILE"

rm -f "$tmp"
exit 0
