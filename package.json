{
  "name": "continuum",
  "version": "0.1.0",
  "private": false,
  "description": "One project. Any agent. No lost context. Local desktop workspace for AI-assisted development.",
  "license": "MIT",
  "author": "Continuum contributors",
  "keywords": [
    "electron",
    "ai",
    "agents",
    "kanban",
    "canvas",
    "claude",
    "cursor",
    "continuum",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Haroon966/Continuum.git"
  },
  "bugs": {
    "url": "https://github.com/Haroon966/Continuum/issues"
  },
  "homepage": "https://github.com/Haroon966/Continuum#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "ELECTRON_DISABLE_GPU=1 vite",
    "start": "ELECTRON_DISABLE_GPU=1 vite",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:git-hooks": "bash .githooks/test-commit-msg.sh"
  },
  "dependencies": {
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.6.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.8"
  }
}
